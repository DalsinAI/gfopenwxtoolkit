+#ifdef __AMIGA__
+// AmigaOS has no uname: the CPU and the system's version come from
+// exec.library (version 47 is AmigaOS 3.2, 46 is 3.1.4, 45 is 3.9, 40 is 3.1)
+#include <exec/execbase.h>
+extern "C" struct ExecBase *SysBase;
+namespace
+{
+const char *wxAmigaCpuName()
+{
+    const UWORD f = SysBase->AttnFlags;
+    if ( f & AFF_68060 ) return "m68060";
+    if ( f & AFF_68040 ) return "m68040";
+    if ( f & AFF_68030 ) return "m68030";
+    if ( f & AFF_68020 ) return "m68020";
+    if ( f & AFF_68010 ) return "m68010";
+    return "m68000";
+}
+
+void wxAmigaRelease(int *major, int *minor, int *micro)
+{
+    const UWORD v = SysBase->LibNode.lib_Version;
+    *major = v < 36 ? 1 : v < 39 ? 2 : 3;
+    *minor = v >= 47 ? 2 : v >= 45 ? 9 : v >= 40 ? 1 : 0;
+    *micro = v == 46 ? 4 : 0;
+}
+} // anonymous namespace
+#endif // __AMIGA__
+
 wxString wxGetCpuArchitectureName()
 {
+#ifdef __AMIGA__
+    return wxAmigaCpuName();
+#else
     return wxGetCommandOutput(wxT("uname -m"));
+#endif
 }
 
 wxString wxGetNativeCpuArchitectureName()

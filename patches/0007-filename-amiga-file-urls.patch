+#if defined(__AMIGA__)
+    // AmigaOS: FileNameToURL() writes "file:///Volume:dir/file"; the slash
+    // before a volume or assign name is not part of the path
+    if ( path.length() > 1 && path[0u] == wxT('/') && path[1u] != wxT('/') )
+    {
+        const int colon = path.Find(wxT(':'));
+        const int slash = path.find(wxT('/'), 1);
+        if ( colon != wxNOT_FOUND &&
+             (slash == (int)wxString::npos || colon < slash) )
+            path = path.Mid(1);
+    }
+#endif // __AMIGA__
+
     path.Replace(wxS('/'), wxFILE_SEP_PATH);
 
     return wxFileName(path, wxPATH_NATIVE);
@@ -2720,7 +2733,13 @@
         if ( (c >= '0' && c <= '9') ||
              (c >= 'a' && c <= 'z') ||
              (c >= 'A' && c <= 'Z') ||
+#if defined(__AMIGA__)
+             // AmigaOS: a volume's ':' is escaped, so that wxFileSystem
+             // does not take "file://Volume:" for a protocol
+             strchr("/$-_.+!*'(),", c) ) // Plus '/'
+#else
              strchr("/:$-_.+!*'(),", c) ) // Plus '/' and ':'
+#endif
         {
             s << c;
         }

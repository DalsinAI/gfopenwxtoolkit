+// what a folder held, or a file was, when last read
+struct wxAmigaFSStat
+{
+    bool isDir;
+    wxULongLong size;
+    time_t mtime;
+};
+WX_DECLARE_STRING_HASH_MAP(wxAmigaFSStat, wxAmigaFSSnapshot);
+
+// one path the thread watches: the user's, or a folder found under a tree
+struct wxAmigaFSNode
+{
+    wxString path;              // as wx gave it (a folder's with its separator)
+    wxCharBuffer name;          // the same for dos.library
+    int events;
+    wxFSWPathType type;
+    wxString filespec;
+    bool own;                   // added under a tree watch by the thread
+    struct NotifyRequest nr;
+    bool notifying;
+    bool exists;
+    wxAmigaFSStat self;         // a file's
+    wxAmigaFSSnapshot entries;  // a folder's
+};
+
+bool wxAmigaFSStatOf(const wxString& path, wxAmigaFSStat *st)
+{
+    wxFileName fn(path);
+    if ( wxFileName::DirExists(path) )
+    {
+        st->isDir = true;
+        st->size = 0;
+        wxDateTime m;
+        st->mtime = fn.GetTimes(NULL, &m, NULL) && m.IsValid() ? m.GetTicks() : 0;
+        return true;
+    }
+    if ( !wxFileName::FileExists(path) )
+        return false;
+    st->isDir = false;
+    st->size = fn.GetSize();
+    wxDateTime m;
+    st->mtime = fn.GetTimes(NULL, &m, NULL) && m.IsValid() ? m.GetTicks() : 0;
+    return true;
+}
+
+wxString wxAmigaFSChild(const wxString& dir, const wxString& name)
+{
+    if ( dir.empty() || dir.Last() == wxT('/') || dir.Last() == wxT(':') )
+        return dir + name;
+    return dir + wxT("/") + name;
+}
+
+void wxAmigaFSReadDir(const wxString& path, wxAmigaFSSnapshot *out)
+{
+    out->clear();
+    wxDir dir;
+    {
+        wxLogNull quiet;
+        if ( !dir.Open(path) )
+            return;
+    }
+    wxString name;
+    for ( bool ok = dir.GetFirst(&name, wxEmptyString, wxDIR_FILES | wxDIR_DIRS | wxDIR_HIDDEN);
+          ok; ok = dir.GetNext(&name) )
+    {
+        wxAmigaFSStat st;
+        if ( wxAmigaFSStatOf(wxAmigaFSChild(path, name), &st) )
+            (*out)[name] = st;
+    }
+}
+
+} // anonymous namespace

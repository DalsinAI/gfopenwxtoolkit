+wxPollingFileSystemWatcher::wxPollingFileSystemWatcher()
+    : wxFileSystemWatcherBase()
+{
+    Init();
+}
+
+wxPollingFileSystemWatcher::wxPollingFileSystemWatcher(const wxFileName& path, int events)
+    : wxFileSystemWatcherBase()
+{
+    if ( !Init() )
+        return;
+    Add(path, events);
+}
+
+wxPollingFileSystemWatcher::~wxPollingFileSystemWatcher()
+{
+}
+
+bool wxPollingFileSystemWatcher::Init()
+{
+    // kept when its thread can't start: then nothing can be added
+    m_service = new wxFSWatcherImplAmiga(this);
+    return m_service->Init();
+}

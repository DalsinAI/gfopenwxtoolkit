+// ----------------------------------------------------------------------------
+// AmigaOS: dos.library's notification (StartNotify) tells that a file, or
+// something in a folder, changed, not what: a thread of the watcher's own
+// gets the messages, reads the folder again and says what is new, gone or
+// changed against what it read before. A file system without notification
+// is read again every two seconds instead.
+// (c) 2026 AmiCradle Team, wxWindows licence
+// ----------------------------------------------------------------------------
+
+#include "wx/private/fswatcher.h"
+#include "wx/thread.h"
+#include "wx/dir.h"
+#include "wx/vector.h"
+#include "wx/hashmap.h"
+
+#include <exec/ports.h>
+#include <exec/tasks.h>
